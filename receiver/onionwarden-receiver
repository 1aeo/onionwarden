#!/usr/bin/env python3
"""onionwarden-receiver — off-box receiver-side verification & rollup (PLAN §4).

Runs on the trusted, off-fleet receiver host. The receiver actively checks —
it does not just store events. Subcommands:

  verify-record [HOST...]   capture each host's current self-hash + pubkey hash
                            as the off-box known-good (do this once, at the
                            Phase-0 bootstrap, from a host you trust).
  verify-check              compare every host's latest reported self-hash +
                            pubkey hash against the known-good; CRIT on a
                            mismatch (C2/H5 — the anchor the on-box check
                            structurally cannot be). Exit 2 if any mismatch.
  seqcheck                  per-host events.log sequence-gap detection (M7):
                            a gap means an omitted event (a dropped CRIT).
  digest                    ONE fleet-rollup line per host for the last 24h
                            (H8 — one rollup, not nine all-clear pushes).

Env: ONIONWARDEN_RECEIVER_ROOT (default ~/onionwarden), ONIONWARDEN_RECEIVER_NTFY
(optional ntfy URL for verify-check CRIT pushes).
"""
import calendar
import json
import os
import sys
import time
import urllib.request

ROOT = os.environ.get("ONIONWARDEN_RECEIVER_ROOT",
                       os.path.join(os.path.expanduser("~"), "onionwarden"))


def host_dirs():
    if not os.path.isdir(ROOT):
        return []
    out = []
    for name in sorted(os.listdir(ROOT)):
        d = os.path.join(ROOT, name)
        if os.path.isdir(d) and not name.startswith(".") and not name.startswith("_"):
            out.append((name, d))
    return out


_PARSE_FAIL_COUNTS = {}


def read_events(host_dir):
    """Yield parsed event dicts from a host's events.log (skips junk lines)."""
    path = os.path.join(host_dir, "events.log")
    if not os.path.isfile(path):
        return
    fails = 0
    with open(path, "r", errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line or not line.startswith("{"):
                continue
            try:
                yield json.loads(line)
            except json.JSONDecodeError:
                fails += 1
                continue
    if fails:
        _PARSE_FAIL_COUNTS[host_dir] = fails


def latest_of_kind(host_dir, kind):
    """The newest event of KIND — selected by the highest `seq` (R8-1), not by
    file order, so a replayed lower-seq entry cannot masquerade as latest."""
    best = None
    best_seq = None
    for ev in read_events(host_dir):
        if ev.get("kind") != kind:
            continue
        seq = ev.get("seq")
        if isinstance(seq, int):
            if best_seq is None or seq > best_seq:
                best, best_seq = ev, seq
        elif best_seq is None:
            best = ev
    return best


def events_log_age_seconds(host_dir):
    """Seconds since the host's events.log was last appended.

    R2-F2: prefer the receiver-stamped `recv_ts` of the highest-seq event
    over file mtime. mtime is mutable by `touch` even with +a, so an
    attacker with a shell on the receiver can mask staleness; recv_ts is
    written by the appender and stored inside the (+a) events.log.
    Falls back to mtime if no event has recv_ts (rolling-update compat).
    """
    path = os.path.join(host_dir, "events.log")
    if not os.path.isfile(path):
        return None
    best_seq = None
    best_recv = None
    for ev in read_events(host_dir):
        rt = ev.get("recv_ts")
        seq = ev.get("seq")
        if rt and isinstance(seq, int) and (best_seq is None or seq > best_seq):
            best_seq = seq
            best_recv = rt
    if best_recv:
        try:
            # calendar.timegm interprets the struct as UTC, so no DST math.
            t = calendar.timegm(time.strptime(best_recv, "%Y-%m-%dT%H:%M:%SZ"))
            return time.time() - t
        except (ValueError, TypeError):
            pass
    return time.time() - os.path.getmtime(path)


def ntfy(title, body):
    url = os.environ.get("ONIONWARDEN_RECEIVER_NTFY", "")
    if not url:
        return
    try:
        req = urllib.request.Request(
            url, data=body.encode(),
            headers={"Title": title, "Priority": "max", "Tags": "rotating_light"})
        urllib.request.urlopen(req, timeout=15).read()
    except Exception as exc:  # noqa: BLE001
        sys.stderr.write("receiver: ntfy push failed: %s\n" % exc)


def cmd_verify_record(hosts):
    """Snapshot each host's current self-hash + pubkey hash as known-good.

    Writes `known_good.json` (the file used by verify-check). R2-F1: also
    appends an audit-trail event to events.log carrying the same payload —
    that record is +a-protected, so if the JSON file is later forged a
    sysadmin can reconstruct the legitimate baseline by reading the last
    `verify_record` event line.
    """
    targets = hosts or [h for h, _ in host_dirs()]
    for host in targets:
        hd = os.path.join(ROOT, host)
        ev = latest_of_kind(hd, "selfreport")
        if not ev:
            sys.stderr.write("verify-record: %s — no selfreport event yet\n" % host)
            continue
        detail = ev.get("detail", {})
        kg = {"selfhash": detail.get("selfhash"),
              "pubkeyhash": detail.get("pubkeyhash"),
              "version": detail.get("version"),
              "recorded_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
        with open(os.path.join(hd, "known_good.json"), "w") as fh:
            json.dump(kg, fh, indent=2)
        # R2-F1: audit-trail event in the +a events.log.
        audit = {"seq": -1, "ts": kg["recorded_at"], "host_id": host,
                 "kind": "verify_record", "severity": "INFO",
                 "detail": {"recorded_known_good": kg}}
        with open(os.path.join(hd, "events.log"), "a") as fh:
            fh.write(json.dumps(audit, separators=(",", ":")) + "\n")
        print("recorded known-good for %s: selfhash=%s" % (host, kg["selfhash"]))
    return 0


def host_stale_minutes(hd, default):
    """R3-F2: per-host override at <hd>/.stale_minutes; fall back to default."""
    p = os.path.join(hd, ".stale_minutes")
    if os.path.isfile(p):
        try:
            return int(open(p).read().strip())
        except (ValueError, OSError):
            pass
    return default


def cmd_verify_check():
    mismatches = 0
    stale_default = int(os.environ.get("ONIONWARDEN_STALE_MINUTES", "30"))
    for host, hd in host_dirs():
        host_msgs = []   # R3-F5: dedup ntfy — at most one push per host per run

        # R8-3: a host that has stopped APPENDING has gone dark on the receiver
        # even if its dead-man pings still arrive (separate channel, or its
        # events were redirected via a forged host_id).
        stale_minutes = host_stale_minutes(hd, stale_default)
        age = events_log_age_seconds(hd)
        if age is not None and age > stale_minutes * 60:
            mismatches += 1
            line = ("CRIT  %s — events.log silent for %d min (> %d) — host has "
                    "stopped appending" % (host, age / 60, stale_minutes))
            print(line); host_msgs.append(line)

        kg_path = os.path.join(hd, "known_good.json")
        if not os.path.isfile(kg_path):
            print("WARN  %s — no known-good recorded (run verify-record)" % host)
        else:
            try:
                with open(kg_path) as fh:
                    kg = json.load(fh)
            except (json.JSONDecodeError, OSError) as exc:
                print("WARN  %s — known_good.json unreadable: %s" % (host, exc))
                kg = None
            ev = latest_of_kind(hd, "selfreport")
            if kg is not None and ev is None:
                print("WARN  %s — no selfreport event to compare" % host)
            elif kg is not None and ev is not None:
                detail = ev.get("detail", {})
                host_mismatched = False
                for field in ("selfhash", "pubkeyhash"):
                    want, got = kg.get(field), detail.get(field)
                    if want and got and want != got:
                        mismatches += 1; host_mismatched = True
                        line = ("CRIT  %s — %s MISMATCH: known-good=%s reported=%s"
                                % (host, field, want, got))
                        print(line); host_msgs.append(line)
                if not host_mismatched and not host_msgs:
                    print("ok    %s — selfhash + pubkeyhash match known-good" % host)

        # R3-F5: single ntfy push per host per run, body lists all triggers.
        if host_msgs:
            ntfy("onionwarden receiver CRIT: %s" % host, "\n".join(host_msgs))
    return 2 if mismatches else 0


def _seqcheck_state_load(hd):
    p = os.path.join(hd, ".seqcheck.state.json")
    if not os.path.isfile(p):
        return {"last_seq": None, "last_offset": 0, "ack_resets_through_seq": None}
    try:
        with open(p) as fh:
            return json.load(fh)
    except (json.JSONDecodeError, OSError):
        return {"last_seq": None, "last_offset": 0, "ack_resets_through_seq": None}


def _seqcheck_state_save(hd, state):
    p = os.path.join(hd, ".seqcheck.state.json")
    with open(p, "w") as fh:
        json.dump(state, fh)


def cmd_seqcheck():
    """R3-F3 + F4: seek-based, stateful per-host scan.

    Each run resumes from <hd>/.seqcheck.state.json: last byte offset, last
    seq seen, and a 'reset acked through' marker (so a legitimate appender
    restart only WARNs once). Gaps are computed only across the NEW slice,
    against the prior last_seq, so memory and CPU are bounded per run."""
    issues = 0
    for host, hd in host_dirs():
        state = _seqcheck_state_load(hd)
        path = os.path.join(hd, "events.log")
        new_seqs = []
        new_offset = state["last_offset"]
        if os.path.isfile(path):
            with open(path, "r", errors="replace") as fh:
                if state["last_offset"] > os.path.getsize(path):
                    # log was rotated; restart from 0.
                    state = {"last_seq": None, "last_offset": 0,
                             "ack_resets_through_seq": None}
                fh.seek(state["last_offset"])
                # Use readline (not `for line in fh`) so fh.tell() stays valid.
                while True:
                    line = fh.readline()
                    if not line:
                        break
                    new_offset = fh.tell()
                    line = line.strip()
                    if not line or not line.startswith("{"):
                        continue
                    try:
                        ev = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    s = ev.get("seq")
                    if isinstance(s, int) and s >= 0:
                        new_seqs.append(s)

        prior_last = state["last_seq"]
        all_seqs = ([prior_last] if prior_last is not None else []) + new_seqs
        if not new_seqs:
            print("ok    %s — no new events since last run" % host)
            state["last_offset"] = new_offset
            _seqcheck_state_save(hd, state)
            continue

        lo, hi = min(all_seqs), max(all_seqs)
        present = set(all_seqs)
        gaps = [n for n in range(lo, hi + 1) if n not in present]
        # R3-F4: reset detected only if the NEW slice has a step-down.
        ack_through = state.get("ack_resets_through_seq")
        new_reset = any(b <= a for a, b in zip(new_seqs, new_seqs[1:]))
        if prior_last is not None and new_seqs and new_seqs[0] <= prior_last:
            new_reset = new_reset or (ack_through is None or new_seqs[0] > ack_through)
        # If we already acked all resets up to this max, suppress further WARN.
        if new_reset and ack_through is not None and max(new_seqs) <= ack_through:
            new_reset = False

        if gaps:
            issues += 1
            print("CRIT  %s — events.log sequence gaps: %s missing in [%d..%d] (%s)"
                  % (host, len(gaps), lo, hi, gaps[:20]))
        if new_reset:
            issues += 1
            print("WARN  %s — sequence reset detected (lowest new seq=%d <= prior=%s) "
                  "— host state/ may have been wiped"
                  % (host, new_seqs[0], prior_last))
        if not gaps and not new_reset:
            print("ok    %s — %d new events, contiguous [%d..%d]"
                  % (host, len(new_seqs), lo, hi))

        # Persist state: ratchet last_seq, ack any reset just reported.
        state["last_seq"] = max(new_seqs)
        state["last_offset"] = new_offset
        if new_reset:
            state["ack_resets_through_seq"] = max(new_seqs)
        _seqcheck_state_save(hd, state)
    return 2 if issues else 0


def cmd_digest():
    now = time.time()
    cutoff = now - 24 * 3600
    print("=== onionwarden fleet digest %s ==="
          % time.strftime("%Y-%m-%d", time.gmtime(now)))
    print("%-14s %5s %5s %5s  %-9s %s"
          % ("host", "CRIT", "WARN", "INFO", "version", "note"))
    for host, hd in host_dirs():
        crit = warn = info = 0
        version = "?"
        note = ""
        for ev in read_events(hd):
            ts = ev.get("ts", "")
            # crude 24h window by parsing the ISO timestamp (UTC; no DST math)
            try:
                t = calendar.timegm(time.strptime(ts, "%Y-%m-%dT%H:%M:%SZ"))
            except (ValueError, TypeError):
                t = now
            if t < cutoff:
                continue
            sev = ev.get("severity", "")
            if sev == "CRIT":
                crit += 1
            elif sev == "WARN":
                warn += 1
            elif sev == "INFO":
                info += 1
            if ev.get("kind") == "digest":
                d = ev.get("detail", {})
                version = d.get("version", version)
                if d.get("disabled", 0):
                    note = "disabled-checks=%s" % d["disabled"]
        flag = "  <-- CRIT" if crit else ""
        # R3-F7: surface in-progress corruption to operator.
        pf = _PARSE_FAIL_COUNTS.get(hd, 0)
        if pf:
            note = (note + " " if note else "") + "parse-fail=%d" % pf
        print("%-14s %5d %5d %5d  %-9s %s%s"
              % (host, crit, warn, info, version, note, flag))
    return 0


def main(argv):
    if len(argv) < 2:
        sys.stderr.write(__doc__)
        return 2
    cmd = argv[1]
    if cmd == "verify-record":
        return cmd_verify_record(argv[2:])
    if cmd == "verify-check":
        return cmd_verify_check()
    if cmd == "seqcheck":
        return cmd_seqcheck()
    if cmd == "digest":
        return cmd_digest()
    sys.stderr.write("onionwarden-receiver: unknown command %r\n" % cmd)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
