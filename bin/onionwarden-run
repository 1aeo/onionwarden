#!/usr/bin/env bash
# bin/onionwarden-run — timer-invoked dispatcher (PLAN §3.1, §3.2).
#
# Invoked by the onionwarden-{fast,slow,daily} systemd services. Verifies the
# signed baseline + host.conf, detects the host profile, runs every check at
# the requested cadence under a per-check timeout + memory cap, logs structured
# findings, drives the dead-man heartbeat, and routes alerts off-box.
#
# Usage: onionwarden-run fast|slow|daily
set -euo pipefail

_bin_dir=$(cd "$(dirname "$0")" && pwd)
ONIONWARDEN_ROOT=$(cd "$_bin_dir/.." && pwd); export ONIONWARDEN_ROOT
# shellcheck source=lib/common.sh
. "$ONIONWARDEN_ROOT/lib/common.sh"
# shellcheck source=lib/stage_tracker.sh
. "$ONIONWARDEN_ROOT/lib/stage_tracker.sh"
# shellcheck source=lib/config.sh
. "$ONIONWARDEN_ROOT/lib/config.sh"
# shellcheck source=lib/profile.sh
. "$ONIONWARDEN_ROOT/lib/profile.sh"
# shellcheck source=lib/verify.sh
. "$ONIONWARDEN_ROOT/lib/verify.sh"
# shellcheck source=lib/baseline.sh
. "$ONIONWARDEN_ROOT/lib/baseline.sh"
# shellcheck source=lib/alert.sh
. "$ONIONWARDEN_ROOT/lib/alert.sh"
# Optional layers — present from Phase 2 onward; the dispatcher works without.
[ -f "$ONIONWARDEN_ROOT/lib/suppress.sh" ] && . "$ONIONWARDEN_ROOT/lib/suppress.sh"
[ -f "$ONIONWARDEN_ROOT/lib/fatal.sh" ]    && . "$ONIONWARDEN_ROOT/lib/fatal.sh"

# Args: a cadence (fast|slow|daily) and/or --from-snapshot DIR.
#
# --from-snapshot DIR puts the dispatcher in OFFLINE mode: it never runs a
# live collector, it reads each check's pre-captured state from DIR/<check>.current
# (typically produced by bin/onionwarden-snapshot from a read-only remote pull),
# and it analyses every check regardless of cadence. With no baseline, every
# current item shows as a "new" finding — that is the intended bootstrap
# inventory (PLAN §5). Offline mode does no alerting, heartbeat, or fatal action.
CADENCE=""
FROM_SNAPSHOT=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    fast|slow|daily) CADENCE=$1; shift ;;
    --from-snapshot) FROM_SNAPSHOT=$2; shift 2 ;;
    *) die "usage: onionwarden-run [fast|slow|daily] [--from-snapshot DIR]" ;;
  esac
done
[ -n "$CADENCE" ] || CADENCE="fast"
SNAPSHOT_MODE="no"
if [ -n "$FROM_SNAPSHOT" ]; then
  [ -d "$FROM_SNAPSHOT" ] || die "onionwarden-run: --from-snapshot dir not found: $FROM_SNAPSHOT"
  SNAPSHOT_MODE="yes"
fi

CHECK_TIMEOUT="${ONIONWARDEN_CHECK_TIMEOUT:-45}"
# R9-2: ulimit -v is a coarse runaway-catcher (caps address space, not RSS) —
# generous so `aide --check` is not strangled; the systemd unit MemoryMax is
# the real run-level cgroup cap.
CHECK_MEM_KB="${ONIONWARDEN_CHECK_MEM_KB:-1572864}"      # 1.5 GB address space
CHECK_FSIZE_KB="${ONIONWARDEN_CHECK_FSIZE_KB:-524288}"   # R9-5: 512 MB output cap
LOG_MAX_BYTES="${ONIONWARDEN_LOG_MAX_BYTES:-104857600}"  # R9-4: rotate at 100 MB

RUN_ID="${ONIONWARDEN_RUN_ID:-$(now_iso | tr -d ':-')-$$}"
export ONIONWARDEN_RUN_ID="$RUN_ID"

LOG_DIR=$(onionwarden_log_dir)
STATE_DIR=$(onionwarden_state_dir)
BASELINE_DIR=$(onionwarden_baseline_dir)
HOST_CONF=$(onionwarden_host_conf)
mkdir -p "$LOG_DIR" "$STATE_DIR" 2>/dev/null || true
LOG_FILE="$LOG_DIR/runs.ndjson"

# R9-4: size-capped log rotation (no logrotate dependency). Keeps one .1 file,
# so on-disk is bounded to ~2x LOG_MAX_BYTES.
if [ -f "$LOG_FILE" ]; then
  _logsz=$(wc -c < "$LOG_FILE" 2>/dev/null || printf 0)
  if [ "${_logsz:-0}" -gt "$LOG_MAX_BYTES" ]; then
    mv -f "$LOG_FILE" "$LOG_FILE.1" 2>/dev/null || true
  fi
fi

RUN_DIR=$(mktemp -d "${TMPDIR:-/tmp}/onionwarden-run.XXXXXX")
FINDINGS="$RUN_DIR/findings.ndjson"; : > "$FINDINGS"
cleanup() { cfg_cleanup; rm -rf "$RUN_DIR"; }
trap cleanup EXIT

# Serialize runs: if a previous tick is still running, skip this one quietly
# (the timer model means we lose one interval, not the watchdog — PLAN §3.1).
if command -v flock >/dev/null 2>&1; then
  exec 8>"$STATE_DIR/run.lock"
  if ! flock -n 8; then
    log_warn "onionwarden-run: a run is already in progress — skipping $CADENCE tick"
    exit 0
  fi
fi

# --- config ---------------------------------------------------------------
# Snapshot mode runs unfiltered (no host.conf, no allowlists) so the inventory
# shows everything — that is the raw material for building the allowlist.
if [ "$SNAPSHOT_MODE" = "yes" ] && [ ! -f "$HOST_CONF" ]; then
  HOST_CONF="$RUN_DIR/host.conf"
  printf 'host_id = "%s"\nrole = "generic"\n' \
    "$(basename "$FROM_SNAPSHOT" | tr -cd 'A-Za-z0-9_.-')" > "$HOST_CONF"
fi
[ -f "$HOST_CONF" ] || die "onionwarden-run: host.conf missing: $HOST_CONF"
cfg_load "$HOST_CONF" "$ONIONWARDEN_ROOT/roles"
export _CFG_STORE
ROLE="$_CFG_ROLE"
HOST_ID=$(cfg_get host_id unknown)
# ONIONWARDEN_PUBKEY overrides the configured path (test seam / relocated installs).
PUBKEY="${ONIONWARDEN_PUBKEY:-$(cfg_get verify_pubkey_path "$ONIONWARDEN_ROOT/onionwarden.pub")}"

RUN_MAX_SEV="OK"
NA_COUNT=0; DISABLED_COUNT=0; CLEAN_COUNT=0; DEVIATION_COUNT=0; FINDING_COUNT=0

# emit a synthetic dispatcher-level finding (bad signature, unsupported OS...).
dispatch_synth() {
  emit_finding "dispatcher" "$1" "$2" "$3" "$4" "$5" "${6:-false}" >> "$FINDINGS"
}

# --- profile --------------------------------------------------------------
PROFILE_FILE="$RUN_DIR/profile.state"
if [ "$SNAPSHOT_MODE" = "yes" ]; then
  # Offline: the profile comes from the snapshot.
  if [ -f "$FROM_SNAPSHOT/profile.state" ]; then
    cp "$FROM_SNAPSHOT/profile.state" "$PROFILE_FILE"
  else
    : > "$PROFILE_FILE"
  fi
# Replay seam: ONIONWARDEN_PROFILE_FILE supplies a pre-captured profile (used by
# the test suite to exercise the dispatcher with a Linux profile on any host).
elif [ -n "${ONIONWARDEN_PROFILE_FILE:-}" ] && [ -f "${ONIONWARDEN_PROFILE_FILE:-}" ]; then
  cp "$ONIONWARDEN_PROFILE_FILE" "$PROFILE_FILE"
elif ! "$_bin_dir/onionwarden-detect-profile" "$PROFILE_FILE" >/dev/null 2>&1; then
  profile_detect > "$PROFILE_FILE" 2>/dev/null || : > "$PROFILE_FILE"
fi
prof_load "$PROFILE_FILE"
export _PROF_FILE="$PROFILE_FILE"

REFUSE_RUN="no"
if [ "$SNAPSHOT_MODE" != "yes" ] && [ "$(prof_get os_supported true)" = "false" ]; then
  dispatch_synth unsupported_os CRIT \
    "onionwarden refuses to run on unsupported OS '$(prof_get os_id)'" "ubuntu/debian" "$(prof_get os_id)" true
  REFUSE_RUN="yes"
fi

# --- suppression window (#10/#11) -----------------------------------------
ONIONWARDEN_SUPPRESS_PHYSICAL="inactive"
if command -v suppress_physical_active >/dev/null 2>&1 && suppress_physical_active; then
  ONIONWARDEN_SUPPRESS_PHYSICAL="active"
fi
export ONIONWARDEN_SUPPRESS_PHYSICAL

# --- trust state (signed baseline + host.conf) ----------------------------
TRUST="trusted"
BASELINE_USE="$BASELINE_DIR"
HOSTCONF_SIGNED="no"
BOOTSTRAPPING="no"
ANALYZE="yes"

if [ "$SNAPSHOT_MODE" = "yes" ]; then
  # Offline inventory: no signed baseline, no host.conf trust. Every check is
  # analysed against a synthetic empty baseline so every current item reports
  # as a "new" finding — the intended bootstrap inventory (PLAN §5). `tainted 0`
  # seeds the taint check so relay-a's set bits decode as newly-set.
  TRUST="snapshot"
  BASELINE_USE="$RUN_DIR/_snapshot_baseline"
  mkdir -p "$BASELINE_USE/state"
  printf '# onionwarden snapshot inventory — empty baseline\ntainted 0\n' \
    > "$BASELINE_USE/state/_marker.state"
fi

# R2-1: copy the baseline into the run's private tmpdir, then verify and use
# the COPY — so the bytes that were hash-verified are exactly the bytes the
# checks read. Verifying the on-disk baseline and reading it later is a TOCTOU
# (the baseline dir is intentionally not immutable).
if [ "$SNAPSHOT_MODE" != "yes" ]; then
  if [ -d "$BASELINE_DIR" ]; then
    cp -R "$BASELINE_DIR" "$RUN_DIR/baseline" 2>/dev/null && BASELINE_USE="$RUN_DIR/baseline"
  fi
  if [ ! -f "$BASELINE_USE/manifest.json" ]; then
    TRUST="nobaseline"
  elif ! baseline_verify "$BASELINE_USE" "$PUBKEY" 2>/dev/null; then
    TRUST="badbaseline"
  fi
  if [ -f "$HOST_CONF.sig" ] && onionwarden_verify_artifact "$PUBKEY" "$HOST_CONF" 2>/dev/null; then
    HOSTCONF_SIGNED="yes"
  fi
  [ -f "$STATE_DIR/bootstrapping" ] && BOOTSTRAPPING="yes"
fi

if [ "$SNAPSHOT_MODE" = "yes" ]; then
  : # offline inventory — skip the trust gate entirely
elif [ "$TRUST" != "trusted" ] || [ "$HOSTCONF_SIGNED" != "yes" ]; then
  if [ "$BOOTSTRAPPING" = "yes" ]; then
    # M2: suppress signature-CRIT until the first signed round-trip.
    dispatch_synth bootstrapping INFO \
      "bootstrapping: no verified baseline/host.conf yet — collecting only, signature-CRIT suppressed" \
      "signed" "$TRUST/$HOSTCONF_SIGNED"
    ANALYZE="no"
  else
    dispatch_synth baseline_signature CRIT \
      "baseline or host.conf failed Ed25519 verification — state untrusted" \
      "verified" "baseline=$TRUST hostconf_signed=$HOSTCONF_SIGNED" true
    ANALYZE="no"
  fi
elif [ "$BOOTSTRAPPING" = "yes" ]; then
  # First fully-verified run ends the bootstrapping state (M2).
  rm -f "$STATE_DIR/bootstrapping"
  events_append bootstrapping_complete INFO \
    "host '$HOST_ID' bootstrapping complete — first signed baseline + host.conf verified" || true
fi

# R1-3: a degraded C2 pin (install.sh's substitution failed, or a dev/repo
# copy) must not look healthy — surface it (INFO so it rides the digest rather
# than tripping the dead-man every minute; the off-box anchor still covers it).
if [ "$BOOTSTRAPPING" = "no" ] && [ "${ONIONWARDEN_PUBKEY_SHA256_PIN:-}" = "@PUBKEY_SHA256@" ]; then
  dispatch_synth pubkey_pin INFO \
    "verify.sh pubkey-hash pin is unset (@PUBKEY_SHA256@) — C2 on-box pubkey-swap guard inactive (install.sh pins it)" \
    "pinned" "unpinned"
fi

# R1-1: host.conf anti-rollback via the optional signed config_epoch.
if [ "$ANALYZE" = "yes" ]; then
  CFG_EPOCH=$(cfg_get config_epoch 0)
  LAST_EPOCH=$(cat "$STATE_DIR/config_epoch" 2>/dev/null || printf 0)
  case "$CFG_EPOCH$LAST_EPOCH" in
    *[!0-9]*) ;;  # non-numeric — skip the check
    *)
      if [ "$CFG_EPOCH" -lt "$LAST_EPOCH" ]; then
        dispatch_synth config_rollback CRIT \
          "host.conf config_epoch ($CFG_EPOCH) is lower than the last accepted ($LAST_EPOCH) — rollback" \
          "$LAST_EPOCH" "$CFG_EPOCH" true
      else
        printf '%s' "$CFG_EPOCH" > "$STATE_DIR/config_epoch"
      fi ;;
  esac
fi

# --- run checks -----------------------------------------------------------
run_sandboxed() {
  ( ulimit -v "$CHECK_MEM_KB" 2>/dev/null || true
    ulimit -f "$CHECK_FSIZE_KB" 2>/dev/null || true   # R9-5: output-size cap
    if command -v timeout >/dev/null 2>&1; then
      # R9-3: -k 10 sends SIGKILL 10s after SIGTERM so a check that ignores
      # SIGTERM cannot make `timeout` itself hang.
      exec timeout -k 10 "$CHECK_TIMEOUT" "$@"
    else
      exec "$@"
    fi )
}
if ! command -v timeout >/dev/null 2>&1; then
  dispatch_synth check_timeout INFO \
    "coreutils 'timeout' unavailable — per-check time bound is off; only systemd TimeoutStartSec applies" \
    "bounded" "unbounded"
fi

# Top-level watchdog stage: the per-check collect/analyze loop. Each check is
# a nested sub-stage so the operator sees "[onionwarden] N/M run checks,
# i/T check <name> : <status>" — the hierarchical convention (lib/stage_tracker.sh).
# Count check files via a bash loop, not `ls … | wc -l`. Under `set -euo
# pipefail` an `ls` over an empty glob exits non-zero and the pipefail can
# abort the dispatcher before the `[ -f "$cf" ]` fallback in the loop below
# can salvage it (CodeRabbit). The loop is `[ -f ]`-guarded so a literal,
# unexpanded glob does not get counted.
TOTAL_CHECKS=0
for _cf in "$ONIONWARDEN_ROOT"/lib/checks/*.sh; do
  [ -f "$_cf" ] || continue
  TOTAL_CHECKS=$(( TOTAL_CHECKS + 1 ))
done
stage_begin 1 1 "run checks ($CADENCE)"
CHECKS_RAN=0
CHECK_IDX=0
CHECK_FAILURES=0
for cf in "$ONIONWARDEN_ROOT"/lib/checks/*.sh; do
  [ "$REFUSE_RUN" = "yes" ] && break
  [ -f "$cf" ] || continue
  name=$(basename "$cf" .sh)
  CHECK_IDX=$(( CHECK_IDX + 1 ))
  stage_begin "$CHECK_IDX" "$TOTAL_CHECKS" "check $name"
  cad=$(bash "$cf" cadence 2>/dev/null || printf 'unknown')
  [ "$cad" = "boot" ] && cad="slow"
  # Snapshot mode analyses every check regardless of cadence.
  if [ "$SNAPSHOT_MODE" != "yes" ] && [ "$cad" != "$CADENCE" ]; then
    stage_skip "cadence $cad != $CADENCE"
    continue
  fi

  if cfg_list_has disable_checks "$name"; then
    DISABLED_COUNT=$(( DISABLED_COUNT + 1 ))
    printf '{"type":"check_status","ts":"%s","run_id":"%s","check":"%s","status":"disabled"}\n' \
      "$(now_iso)" "$RUN_ID" "$name" >> "$LOG_FILE"
    stage_skip "disabled in host.conf"
    continue
  fi
  CHECKS_RAN=$(( CHECKS_RAN + 1 ))

  cur="$RUN_DIR/$name.current"
  # Offline snapshot mode: the current state comes from the snapshot dir; a
  # check with no captured state is recorded as not_in_snapshot, never collected.
  if [ "$SNAPSHOT_MODE" = "yes" ]; then
    if [ -f "$FROM_SNAPSHOT/$name.current" ]; then
      cp "$FROM_SNAPSHOT/$name.current" "$cur"
    else
      printf '{"type":"check_status","ts":"%s","run_id":"%s","check":"%s","status":"not_in_snapshot"}\n' \
        "$(now_iso)" "$RUN_ID" "$name" >> "$LOG_FILE"
      stage_skip "not in snapshot"
      continue
    fi
  # Replay seam: ONIONWARDEN_FAKE_STATE_DIR supplies pre-captured current state,
  # used by the test suite to drive the full dispatcher path deterministically
  # (and usable for offline replay of a captured host).
  elif [ -n "${ONIONWARDEN_FAKE_STATE_DIR:-}" ] && [ -f "$ONIONWARDEN_FAKE_STATE_DIR/$name.current" ]; then
    cp "$ONIONWARDEN_FAKE_STATE_DIR/$name.current" "$cur"
  elif [ "$name" = "profile" ]; then
    cp "$PROFILE_FILE" "$cur"
  elif ! run_sandboxed bash "$cf" collect > "$cur" 2>/dev/null; then
    dispatch_synth "check_${name}" WARN "check '$name' collect failed or timed out" "ran" "failed"
    printf '{"type":"check_status","ts":"%s","run_id":"%s","check":"%s","status":"collect_failed"}\n' \
      "$(now_iso)" "$RUN_ID" "$name" >> "$LOG_FILE"
    stage_fail "collect failed or timed out"
    CHECK_FAILURES=$(( CHECK_FAILURES + 1 ))
    continue
  fi

  if [ "$ANALYZE" != "yes" ]; then
    printf '{"type":"check_status","ts":"%s","run_id":"%s","check":"%s","status":"collected_only"}\n' \
      "$(now_iso)" "$RUN_ID" "$name" >> "$LOG_FILE"
    stage_skip "untrusted state — collected only"
    continue
  fi

  if [ "$SNAPSHOT_MODE" = "yes" ]; then
    base="$BASELINE_USE/state/_marker.state"   # synthetic empty baseline
  else
    base=$(baseline_state_file "$BASELINE_USE" "$name")
    [ -n "$base" ] || base="/dev/null"
  fi
  if run_sandboxed bash "$cf" analyze --baseline "$base" --current "$cur" \
    >> "$FINDINGS" 2>/dev/null; then
    stage_ok
  else
    dispatch_synth "check_${name}" WARN "check '$name' analyze failed or timed out" "ran" "failed"
    stage_fail "analyze failed or timed out"
    CHECK_FAILURES=$(( CHECK_FAILURES + 1 ))
  fi
done
# Close the top-level "run checks" stage (if the loop broke on REFUSE_RUN with a
# check stage still open, close that first so the stack unwinds cleanly).
if [ "$REFUSE_RUN" = "yes" ]; then
  [ "${#_STAGE_NAMES[@]}" -gt 1 ] && stage_skip "run refused"
  stage_skip "run refused"
elif [ "$CHECK_FAILURES" -gt 0 ]; then
  [ "${#_STAGE_NAMES[@]}" -gt 1 ] && stage_fail "$CHECK_FAILURES check(s) failed"
  stage_fail "$CHECK_FAILURES check(s) failed"
else
  [ "${#_STAGE_NAMES[@]}" -gt 1 ] && stage_ok
  stage_ok
fi

# --- process findings -----------------------------------------------------
sev_of() { printf '%s' "$1" | sed -n 's/.*"severity":"\([A-Z]*\)".*/\1/p'; }

while IFS= read -r core; do
  [ -n "$core" ] || continue
  sev=$(sev_of "$core")
  case "$sev" in
    NA) NA_COUNT=$(( NA_COUNT + 1 )) ;;
    INFO|WARN|CRIT)
      FINDING_COUNT=$(( FINDING_COUNT + 1 ))
      DEVIATION_COUNT=$(( DEVIATION_COUNT + 1 ))
      RUN_MAX_SEV=$(sev_max "$RUN_MAX_SEV" "$sev") ;;
  esac
  printf '{"type":"finding","ts":"%s","run_id":"%s","host_id":"%s",%s\n' \
    "$(now_iso)" "$RUN_ID" "$HOST_ID" "${core#\{}" >> "$LOG_FILE"
done < "$FINDINGS"
CLEAN_COUNT=$(( CHECKS_RAN - DEVIATION_COUNT ))
[ "$CLEAN_COUNT" -lt 0 ] && CLEAN_COUNT=0

printf '{"type":"run_summary","ts":"%s","run_id":"%s","host_id":"%s","cadence":"%s","severity":"%s","checks_ran":%s,"findings":%s,"na":%s,"disabled":%s,"trust":"%s"}\n' \
  "$(now_iso)" "$RUN_ID" "$HOST_ID" "$CADENCE" "$RUN_MAX_SEV" \
  "$CHECKS_RAN" "$FINDING_COUNT" "$NA_COUNT" "$DISABLED_COUNT" "$TRUST" >> "$LOG_FILE"

# --- snapshot mode: offline inventory, no alerting/fatal/heartbeat ---------
if [ "$SNAPSHOT_MODE" = "yes" ]; then
  cp "$FINDINGS" "$FROM_SNAPSHOT/findings.ndjson" 2>/dev/null || true
  # Emit the run summary on early-exit paths too (CodeRabbit) — otherwise
  # --from-snapshot prints per-stage lines but never the final recap that the
  # main path emits below.
  stage_summary
  log_info "onionwarden-run --from-snapshot complete: $FINDING_COUNT finding(s), $CHECKS_RAN checks analysed (offline inventory, no alerts)"
  exit 0
fi

# --- dry-run mode: collect+analyze only, no side effects (onionwarden-fatal) --
if [ "${ONIONWARDEN_DRYRUN:-0}" = "1" ]; then
  if [ -n "${ONIONWARDEN_DRYRUN_FINDINGS:-}" ]; then
    if [ "${ONIONWARDEN_DRYRUN_APPEND:-0}" = "1" ]; then
      cat "$FINDINGS" >> "$ONIONWARDEN_DRYRUN_FINDINGS"
    else
      cp "$FINDINGS" "$ONIONWARDEN_DRYRUN_FINDINGS"
    fi
  fi
  stage_summary
  log_info "onionwarden-run $CADENCE dry-run complete — no heartbeat/alerts/fatal action"
  exit 0
fi

# --- fatal-action evaluation (Phase 2 — no-op if lib/fatal.sh absent) -----
if command -v fatal_evaluate >/dev/null 2>&1; then
  fatal_evaluate "$FINDINGS" "$RUN_MAX_SEV" || true
fi

# --- alerting -------------------------------------------------------------
PUSH_LEVEL=$(cfg_get alert_push_level crit)
case "$PUSH_LEVEL" in warn) PUSH_MIN="WARN" ;; *) PUSH_MIN="CRIT" ;; esac

# 1. heartbeat / dead-man's switch
if [ "$CADENCE" = "fast" ]; then
  case "$RUN_MAX_SEV" in
    WARN|CRIT) deadman_ping fail ;;
    *)         deadman_ping ok ;;
  esac
fi

# 2. events.log — every WARN/CRIT finding is appended for the forensic record
if [ "$FINDING_COUNT" -gt 0 ]; then
  while IFS= read -r core; do
    [ -n "$core" ] || continue
    sev=$(sev_of "$core")
    case "$sev" in
      WARN|CRIT)
        summary=$(printf '%s' "$core" | sed -n 's/.*"summary":"\([^"]*\)".*/\1/p')
        events_append finding "$sev" "$summary" "$core" || true ;;
    esac
  done < "$FINDINGS"
fi

# 2b. self-hash report — every fast run reports its self-hash + pubkey hash so
#     the receiver can compare against its off-box known-good (§3.5 C2/H5).
if [ -f "$RUN_DIR/watchdog_meta.current" ]; then
  sr_self=$(awk '$1=="selfhash"{print $2}' "$RUN_DIR/watchdog_meta.current" | head -n1)
  sr_pub=$(awk '$1=="pubkeyhash"{print $2}' "$RUN_DIR/watchdog_meta.current" | head -n1)
  if [ -n "$sr_self" ]; then
    events_append selfreport INFO "self-hash report" \
      "$(printf '{"selfhash":"%s","pubkeyhash":"%s","version":"%s"}' \
         "$sr_self" "${sr_pub:-none}" "$(onionwarden_version)")" || true
  fi
fi

# 3. ntfy push — one summarised message per run when severity warrants
if [ "$(sev_rank "$RUN_MAX_SEV")" -ge "$(sev_rank "$PUSH_MIN")" ]; then
  body="run $RUN_ID on $HOST_ID ($ROLE): $RUN_MAX_SEV — $FINDING_COUNT finding(s)"$'\n'
  body="$body$(grep -E '"severity":"(WARN|CRIT)"' "$FINDINGS" \
    | sed -n 's/.*"severity":"\([A-Z]*\)".*"summary":"\([^"]*\)".*/  [\1] \2/p' | head -n 12 || true)"
  ntfy_push "$RUN_MAX_SEV" "onionwarden $RUN_MAX_SEV: $HOST_ID" "$body"
fi

# 4. email — CRIT only
if [ "$RUN_MAX_SEV" = "CRIT" ]; then
  onionwarden_email "onionwarden CRIT: $HOST_ID" \
    "Host $HOST_ID run $RUN_ID reported CRIT findings. See events.log on the receiver."
fi

# 5. daily digest (per-host; the receiver rolls these up fleet-wide — §4)
if [ "$CADENCE" = "daily" ]; then
  digest=$(printf '{"version":"%s","selfhash_check":"see watchdog_meta","clean":%s,"na":%s,"disabled":%s,"findings":%s}' \
    "$(onionwarden_version)" "$CLEAN_COUNT" "$NA_COUNT" "$DISABLED_COUNT" "$FINDING_COUNT")
  events_append digest INFO "daily digest for $HOST_ID: severity $RUN_MAX_SEV" "$digest" || true
fi

# Replay any events buffered during a prior receiver outage.
events_flush_buffer || true

stage_summary
log_info "onionwarden-run $CADENCE complete: severity=$RUN_MAX_SEV findings=$FINDING_COUNT trust=$TRUST"
exit 0
