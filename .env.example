# .env.example — copy to `.env` (gitignored) and fill in your fleet's values.
#
# These are the variables consumed by `install.sh`, `scripts/*`, and the
# receiver bootstrap. They are deliberately kept OUT of the repo so the
# public template is fleet-agnostic.

# --- receiver host ---------------------------------------------------------
ONIONWARDEN_RECEIVER_HOST=<CHANGE-ME-receiver.example.net>
ONIONWARDEN_RECEIVER_PORT=<CHANGE-ME-22922>
ONIONWARDEN_RECEIVER_USER=onionwarden                  # forced-command user on receiver
ONIONWARDEN_ADMIN_USER=<CHANGE-ME-admin>               # interactive sudo admin on receiver
ONIONWARDEN_RECEIVER_ROOT=/var/lib/onionwarden         # event-log root on receiver

# --- alerting --------------------------------------------------------------
ONIONWARDEN_NTFY=https://ntfy.sh/<CHANGE-ME-unguessable-topic>
ONIONWARDEN_NTFY_TOKEN=                                # optional
ONIONWARDEN_DEADMAN_PROVIDER=healthchecks-saas         # or `ntfy`, `cron-email`
ONIONWARDEN_DEADMAN_URL_BASE=https://hc-ping.com/      # per-host UUIDs appended in host.conf
ONIONWARDEN_EMAIL_TO=alerts@<CHANGE-ME-example.net>

# --- collector defaults ----------------------------------------------------
ONIONWARDEN_ALERT_PUSH_LEVEL=warn                      # warn|crit — canary starts at warn
ONIONWARDEN_OFFBOX_RETENTION=365d
ONIONWARDEN_PHYSICAL_ACCESS_ALLOWED=false              # fleet default

# --- signing key custody ---------------------------------------------------
# The fleet-wide baseline-signing keypair (collectors verify against the
# pubkey at install time). Generate ONCE on a trusted laptop with:
#   python3 lib/ed25519.py keygen onionwarden.priv onionwarden.pub
# Then commit `onionwarden.pub` and store `onionwarden.priv` offline.
ONIONWARDEN_PUBKEY_PATH=./onionwarden.pub              # path used by install.sh --pubkey

# --- BGP / network expectations (optional, per-host) -----------------------
# Used by lib/checks/ports.sh to detect bind-IP regressions. Override in
# hosts/<host_id>.conf if a relay binds bgpd / tor to a specific IP.
# ONIONWARDEN_EXPECTED_BGP_BIND=<CHANGE-ME-203.0.113.50>
