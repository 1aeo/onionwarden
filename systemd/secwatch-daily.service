[Unit]
Description=onionwarden daily deep tamper checks + digest (PLAN §3.2)
Documentation=file:/opt/onionwarden/PLAN.md
ConditionPathExists=/opt/onionwarden/bin/onionwarden-run

[Service]
Type=oneshot
ExecStart=/opt/onionwarden/bin/onionwarden-run daily
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/onionwarden /var/log/onionwarden
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=1G
TasksMax=256
TimeoutStartSec=1800
